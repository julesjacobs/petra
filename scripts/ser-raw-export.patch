+//! Export the reachability question before complement, DNF, and Petri reductions.
+use crate::ns::NS;
+use crate::ns_to_petri::{ns_to_petri_with_requests, ReqPetriState};
+use crate::semilinear::{SemilinearSet, SparseVector};
+use serde_json::{json, Value};
+use std::{collections::BTreeMap, fmt::{Debug, Display}, hash::Hash};
+use std::sync::atomic::{AtomicBool, Ordering};
+
+pub static ENABLED: AtomicBool = AtomicBool::new(false);
+pub fn enabled() -> bool { ENABLED.load(Ordering::SeqCst) }
+
+pub fn export<G, L, Req, Resp>(ns: &NS<G,L,Req,Resp>, out_dir: &str) -> std::io::Result<()>
+where G: Clone + Ord + Hash + Display + Debug,
+      L: Clone + Ord + Hash + Display + Debug,
+      Req: Clone + Ord + Hash + Display + Debug,
+      Resp: Clone + Ord + Hash + Display + Debug,
+{
+    use ReqPetriState::*;
+    let petri = ns_to_petri_with_requests(ns);
+    let mut places = petri.get_places_sorted();
+    let serial: SemilinearSet<_> = ns.serialized_automaton_kleene(|req, resp| {
+        SemilinearSet::singleton(SparseVector::unit(Response(req, resp)))
+    });
+    for component in &serial.components {
+        component.for_each_key(|p| { if !places.contains(p) { places.push(p.clone()); } });
+    }
+    places.sort();
+    let ids: BTreeMap<_,_> = places.iter().cloned().enumerate().map(|(i,p)| (p,i)).collect();
+    let arcs = |ps: Vec<ReqPetriState<L,G,Req,Resp>>| -> Vec<(usize,usize)> {
+        let mut counts = BTreeMap::new();
+        for p in ps { *counts.entry(ids[&p]).or_insert(0) += 1; }
+        counts.into_iter().collect()
+    };
+    let sparse = |v: &SparseVector<ReqPetriState<L,G,Req,Resp>>| -> Vec<(usize,usize)> {
+        let mut result: Vec<_> = v.values.iter().map(|(p,n)| (ids[p],*n)).collect();
+        result.sort(); result
+    };
+    let mut initial = vec![0usize; places.len()];
+    for p in petri.get_initial_marking() { initial[ids[&p]] += 1; }
+    let transitions: Vec<Value> = petri.get_transitions().into_iter().enumerate().map(|(i,(pre,post))| {
+        json!({"name":format!("t{}",i),"pre":arcs(pre),"post":arcs(post)})
+    }).collect();
+    let components: Vec<Value> = serial.components.iter().map(|c| json!({
+        "base":sparse(&c.base), "periods":c.periods.iter().map(&sparse).collect::<Vec<_>>()
+    })).collect();
+    let zero_places: Vec<_> = places.iter().enumerate().filter_map(|(i,p)| matches!(p,Local(_,_)|Request(_)).then_some(i)).collect();
+    let response_places: Vec<_> = places.iter().enumerate().filter_map(|(i,p)| matches!(p,Response(_,_)).then_some(i)).collect();
+    let query = json!({
+        "format":"ser-raw-v1",
+        "places":places.iter().map(ToString::to_string).collect::<Vec<_>>(),
+        "initial":initial,"transitions":transitions,
+        "target":{"kind":"completed-outside-semilinear", "zero_places":zero_places,
+                  "response_places":response_places,"excluded_semilinear":components},
+        "provenance":{"stage":"request-tracking-net-before-complement",
+            "petri_places":places.len(),"petri_transitions":transitions.len(),
+            "serial_components":components.len(),
+            "bidirectional_pruning":false,"disjunct_decomposition":false,
+            "presburger_complement":false,"solver_invoked":false,"cache_used":false,
+            "remove_redundant":false,"generate_less":false,"smart_kleene_order":false}
+    });
+    std::fs::write(format!("{out_dir}/raw-query.json"),serde_json::to_vec_pretty(&query)?)?;
+    std::fs::write(format!("{out_dir}/raw.net"),crate::smpt::petri_to_pnet(&petri,"raw"))?;
+    println!("Raw query: {out_dir}/raw-query.json ({} places, {} transitions, {} serial components)",places.len(),transitions.len(),components.len());
+    Ok(())
+}
