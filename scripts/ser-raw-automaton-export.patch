+fn automaton_query<G, L, Req, Resp>(ns: &NS<G,L,Req,Resp>) -> Value
+where G: Clone + Ord + Hash + Display + Debug,
+      L: Clone + Ord + Hash + Display + Debug,
+      Req: Clone + Ord + Hash + Display + Debug,
+      Resp: Clone + Ord + Hash + Display + Debug,
+{
+    use ReqPetriState::*;
+    let petri = ns_to_petri_with_requests(ns);
+    let serial = ns.serialized_automaton();
+    let mut places = petri.get_places_sorted();
+    places.extend(serial.iter().map(|(_,req,resp,_)| Response(req.clone(),resp.clone())));
+    places.sort();
+    places.dedup();
+    let ids: BTreeMap<_,_> = places.iter().cloned().enumerate().map(|(i,p)| (p,i)).collect();
+    let arcs = |ps: Vec<ReqPetriState<L,G,Req,Resp>>| -> Vec<(usize,usize)> {
+        let mut counts = BTreeMap::new();
+        for p in ps { *counts.entry(ids[&p]).or_insert(0) += 1; }
+        counts.into_iter().collect()
+    };
+    let mut initial = vec![0usize; places.len()];
+    for p in petri.get_initial_marking() { initial[ids[&p]] += 1; }
+    let transitions: Vec<Value> = petri.get_transitions().into_iter().enumerate().map(|(i,(pre,post))| {
+        json!({"name":format!("t{}",i),"pre":arcs(pre),"post":arcs(post)})
+    }).collect();
+    let mut states: Vec<_> = ns.get_global_states().into_iter().cloned().collect();
+    states.sort();
+    states.dedup();
+    let state_ids: BTreeMap<_,_> = states.iter().cloned().enumerate().map(|(i,g)| (g,i)).collect();
+    let mut edges: Vec<_> = serial.into_iter().map(|(g,req,resp,h)| {
+        (state_ids[&g], state_ids[&h], ids[&Response(req,resp)])
+    }).collect();
+    edges.sort();
+    edges.dedup();
+    let edges: Vec<Value> = edges.into_iter().map(|(source,target,response)| {
+        json!({"source":source,"target":target,"response":response})
+    }).collect();
+    let zero_places: Vec<_> = places.iter().enumerate().filter_map(|(i,p)| matches!(p,Local(_,_)|Request(_)).then_some(i)).collect();
+    let response_places: Vec<_> = places.iter().enumerate().filter_map(|(i,p)| matches!(p,Response(_,_)).then_some(i)).collect();
+    json!({
+        "format":"ser-raw-v2", "places":places.iter().map(ToString::to_string).collect::<Vec<_>>(),
+        "initial":initial,"transitions":transitions,
+        "target":{"kind":"completed-outside-automaton", "zero_places":zero_places,
+            "response_places":response_places,
+            "excluded_automaton":{"states":states.len(),"initial":state_ids[&ns.initial_global],
+                "accepting":(0..states.len()).collect::<Vec<_>>(),"edges":edges}},
+        "provenance":{"stage":"request-tracking-net-before-serial-parikh-expansion",
+            "petri_places":places.len(),"petri_transitions":transitions.len(),
+            "serial_states":states.len(),"serial_edges":edges.len(),
+            "semilinear_expansion":false,"bidirectional_pruning":false,
+            "disjunct_decomposition":false,"presburger_complement":false,
+            "solver_invoked":false,"cache_used":false,"remove_redundant":false,
+            "generate_less":false,"smart_kleene_order":false}
+    })
+}
+
+fn export_automaton<G, L, Req, Resp>(ns: &NS<G,L,Req,Resp>, out_dir: &str) -> std::io::Result<()>
+where G: Clone + Ord + Hash + Display + Debug,
+      L: Clone + Ord + Hash + Display + Debug,
+      Req: Clone + Ord + Hash + Display + Debug,
+      Resp: Clone + Ord + Hash + Display + Debug,
+{
+    let query = automaton_query(ns);
+    std::fs::write(format!("{out_dir}/raw-query.json"),serde_json::to_vec_pretty(&query)?)?;
+    let petri = ns_to_petri_with_requests(ns);
+    std::fs::write(format!("{out_dir}/raw.net"),crate::smpt::petri_to_pnet(&petri,"raw"))?;
+    println!("Raw automaton query: {out_dir}/raw-query.json ({} states, {} edges)",
+        query["provenance"]["serial_states"],query["provenance"]["serial_edges"]);
+    Ok(())
+}
