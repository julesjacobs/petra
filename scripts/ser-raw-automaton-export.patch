+    #[test]
+    fn bounded_automaton_parikh_image_matches_v1_semilinear_image() {
+        use std::collections::BTreeSet;
+        let mut ns = NS::<usize,usize,usize,usize>::new(2);
+        ns.add_request(7,10);
+        ns.add_request(8,12);
+        ns.add_response(11,20);
+        ns.add_response(13,21);
+        ns.add_transition(10,2,11,1);
+        ns.add_transition(10,1,11,1);
+        ns.add_transition(12,1,13,2);
+        let query = automaton_query(&ns);
+        let automaton = &query["target"]["excluded_automaton"];
+        let places = query["places"].as_array().unwrap();
+        let empty = vec![0usize;places.len()];
+        let mut reached = BTreeSet::from([(automaton["initial"].as_u64().unwrap(),empty.clone())]);
+        let mut pending: Vec<_> = reached.iter().cloned().collect();
+        while let Some((state,counts)) = pending.pop() {
+            if counts.iter().sum::<usize>() == 4 { continue; }
+            for edge in automaton["edges"].as_array().unwrap() {
+                if edge["source"].as_u64().unwrap() != state { continue; }
+                let mut next = counts.clone();
+                next[edge["response"].as_u64().unwrap() as usize] += 1;
+                let next = (edge["target"].as_u64().unwrap(),next);
+                if reached.insert(next.clone()) { pending.push(next); }
+            }
+        }
+        let actual: BTreeSet<_> = reached.into_iter().map(|(_,counts)|counts).collect();
+        let serial: SemilinearSet<_> = ns.serialized_automaton_kleene(|req,resp| {
+            SemilinearSet::singleton(SparseVector::unit(
+                ReqPetriState::<usize,usize,usize,usize>::Response(req,resp)))
+        });
+        let dense = |v: &SparseVector<ReqPetriState<usize,usize,usize,usize>>| {
+            let mut counts = empty.clone();
+            for (p,n) in &v.values {
+                let id = places.iter().position(|name|name == &json!(p.to_string())).unwrap();
+                counts[id] = *n;
+            }
+            counts
+        };
+        let mut expected = BTreeSet::new();
+        for component in serial.components {
+            let base = dense(&component.base);
+            if base.iter().sum::<usize>() > 4 { continue; }
+            let periods: Vec<_> = component.periods.iter().map(&dense).collect();
+            let mut seen = BTreeSet::from([base.clone()]);
+            let mut todo = vec![base];
+            while let Some(counts) = todo.pop() {
+                expected.insert(counts.clone());
+                for period in &periods {
+                    let next: Vec<_> = counts.iter().zip(period).map(|(a,b)|a+b).collect();
+                    if next.iter().sum::<usize>() <= 4 && seen.insert(next.clone()) {
+                        todo.push(next);
+                    }
+                }
+            }
+        }
+        assert_eq!(actual,expected);
+    }
