+impl SolverState {
+    pub fn poll_interrupt(&mut self) -> bool {
+        if self.solver_error.is_some() {
+            return true;
+        }
+        if self.interrupt.as_mut().map_or(false, |callback| callback()) {
+            self.solver_error = Some(SolverError::Interrupted);
+            return true;
+        }
+        false
+    }
